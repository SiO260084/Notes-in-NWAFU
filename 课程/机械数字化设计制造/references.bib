Distributor: Springer
Institution: Springer
Label: Springer
Publisher: Springer London},
	file = {Full Text PDF:/home/sio2/Zotero/storage/RCI9G64B/Gunes - 2024 - A digital twin design methodology for control, simulation, and monitoring of fluidic circuits.pdf:application/pdf},
}
