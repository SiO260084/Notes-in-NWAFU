@article{geng_research_2017,
	title = {Research and application of digital design and manufacturing technology of agricultural machinery},
	volume = {28},
	issn = {1722-6996, 2035-4606},
	abstract = {With rapid development of science and technology, digital technology has been gradually applied to various fields. Development of computer technology also drives development of agricultural machinery manufacturing technology towards digital design, which elevates agricultural machinery manufacturing level as a whole. Current situation in which China's agricultural development was faced with low utility ratio of digital technology, immature technological design and difficulty for its reasonable fusion with manufacturing technology was analyzed in this paper. It's studied that digital design technology had characteristics of realizing parallel design and realizing orientation at assembly. Finally, technologies like {CAD}/{CAM}/{CAPP} were used on basis of digital technology so as to facilitate application of digital design within a larger scope to digital design of agricultural machinery and ultimately realize sustainable development of China's agriculture.},
	pages = {2891--2894},
	number = {1},
	journaltitle = {Agro Food Industry Hi-tech},
	shortjournal = {Agro Food Ind. Hi-tech},
	author = {Geng, Guoqiang and Li, Kunquan},
	urldate = {2025-11-07},
	date = {2017-02},
	langid = {english},
	note = {{numPages}: 4
publisher: Teknoscienze Publ
Web of Science {ID}: {WOS}:000405992300222
{abstractTranslation}: 随着科学技术的快速发展，数字化技术逐渐被应用到各个领域。计算机技术的发展也带动了农业机械制造技术向数字化设计方向发展，从整体上提升了农业机械制造水平。本文分析了当前中国农业发展面临的数字技术利用率低、技术设计不成熟、难以与制造技术合理融合的现状。研究表明，数字化设计技术具有实现并行设计、实现装配定位的特点。 最后，在数字化技术的基础上运用{CAD} / {CAM} / {CAPP等技术}，促进数字化设计在更大范围内应用于农业机械的数字化设计，最终实现我国农业的可持续发展。
{titleTranslation}: 农业机械数字化设计与制造技术的研究与应用。},
	keywords = {agricultural machinery, application research, Biotechnology \& Applied Microbiology, digital design, Food Science \& Technology, manufacturing technology},
}

@article{xin_digital_2023,
	title = {Digital design and manufacturing of spherical joint base on multi-objective topology optimization and 3D printing},
	volume = {49},
	issn = {2352-0124},
	url = {https://www.sciencedirect.com/science/article/pii/S2352012423001029},
	doi = {10.1016/j.istruc.2023.01.101},
	abstract = {Topology optimization techniques have been widely applied for the generation of highly efficient material structures in various fields. In addition, 3D printing has the ability to fabricate geometrically complex optimized results which are difficult to realize for conventional means. The research presented in here aims to implement a digital design and manufacture high-performance joints in space truss by combining topology optimization and 3D printing. Two multi-condition optimization models, i.e., minimum volume model and minimum compliance model, are employed to optimize the spherical joints under multiple conditions. The conditions are three most dangerous load conditions of joints in the space truss. Since single-objective topology optimizations only seek the optimal solution for a single objective, the mechanical properties of the optimized result may be limited. As a result, the compromise programming model, a multi-objective topology optimization model, is designed with the goals of minimum volume and compliance under each condition. In addition, multi-condition and multi-objective topology optimization design of the spherical joints are carried out based on density approach. The advantages of the multi-objective topology optimization are verified by comparing the mechanical performance of the optimized results obtained by the minimum volume model, the minimum compliance model and the compromise programming model. Finally, the additive manufacturing of the optimized results is completed by using 3D printing technology, which verifies the feasibility of digital design and manufacturing of joints.},
	pages = {479--491},
	journaltitle = {Structures},
	shortjournal = {Structures},
	author = {Xin, Q. C. and Yang, L. and Huang, Y. N.},
	urldate = {2025-11-07},
	date = {2023-03-01},
	langid = {english},
	keywords = {3D printing, Digital design and manufacturing, Multi-objective topology optimization, Multiple conditions, Spherical joint},
	file = {ScienceDirect Full Text PDF:/home/sio2/Zotero/storage/6IMJD9N5/Xin et al. - 2023 - Digital design and manufacturing of spherical joint base on multi-objective topology optimization an.pdf:application/pdf;ScienceDirect Snapshot:/home/sio2/Zotero/storage/7RH6XPF8/S2352012423001029.html:text/html},
}

@article{wu_democratizing_2017,
	title = {Democratizing digital design and manufacturing using high performance cloud computing: performance evaluation and benchmarking},
	volume = {43},
	issn = {0278-6125, 1878-6642},
	doi = {10.1016/j.jmsy.2016.09.005},
	shorttitle = {Democratizing digital design and manufacturing using high performance cloud computing},
	abstract = {Cloud computing is an innovative computing paradigm that can bridge the gap between increasing computing demands in computationally intensive tasks for digital design and manufacturing applications and limited resources, scalability, flexibility, and agility in traditional computing paradigms. In light of the benefits of cloud computing, cloud-based high performance computing ({HPC}) has the potential to enable users to not only accelerate computationally expensive tasks, but also to reduce costs by utilizing on-demand, ubiquitous, seamless, and user-friendly access to remote engineering application packages as well as remote {HPC} resources. However, due to uncertainty about computing performance on the cloud, many manufacturers find it challenging to justify and adopt Cloud-Based Design and Manufacturing ({CBDM}). Therefore, the objective of this research is to evaluate the performance of solving a large-scale engineering problem using finite element analysis on several public {HPC} clouds as well as introduce a new workflow for {CBDM}. A set of experiments is conducted to compare the performance of the public {HPC} clouds with that of a standard workstation and a dedicated in-house supercomputer. The performance metrics include elapsed time, speedup, scalability, and stability. Experimental results have shown that the Azure Cloud with 32 cores and the Nimbix Cloud with 16 nodes speed up the finite element analysis over a workstation with 8 cores by more than seven-fold and eight-fold. A dedicated in-house supercomputer speeds up the finite element analysis over cloud computing by approximately two-fold because of better I/O performance and larger memory. In addition, considerable variations of elapsed time for solving the finite element model with multiple nodes in the cloud were observed due to resource sharing in cloud computing. (C) 2016 The Society of Manufacturing Engineers. Published by Elsevier Ltd. All rights reserved.},
	pages = {316--326},
	issue = {{SI}},
	journaltitle = {Journal of Manufacturing Systems},
	shortjournal = {J. Manuf. Syst.},
	author = {Wu, Dazhong and Liu, Xi and Hebert, Steve and Gentzsch, Wolfgang and Terpenny, Janis},
	urldate = {2025-11-07},
	date = {2017-04},
	langid = {english},
	note = {{numPages}: 11
publisher: Elsevier Sci Ltd
Web of Science {ID}: {WOS}:000401390700011},
	keywords = {Benchmark, Cloud computing, Digital design and manufacturing, Engineering, Industrial, Engineering, Manufacturing, Finite element analysis, High performance computing, Operations Research \& Management Science, Performance evaluation},
	file = {ScienceDirect Full Text PDF:/home/sio2/Zotero/storage/PNZJPRKE/Wu et al. - 2017 - Democratizing digital design and manufacturing using high performance cloud computing performance e.pdf:application/pdf;ScienceDirect Snapshot:/home/sio2/Zotero/storage/MNDLLJ33/S0278612516300620.html:text/html},
}

@article{xie_cloud_2019,
	title = {A cloud service platform for the seamless integration of digital design and rapid prototyping manufacturing},
	volume = {100},
	issn = {1433-3015},
	url = {https://doi.org/10.1007/s00170-018-2809-9},
	doi = {10.1007/s00170-018-2809-9},
	abstract = {At present, some service platforms for 3D manufacturing encounter problems, including the low level of integration with digital design ability, the single character of cooperative printings, the uneven distribution of 3D printing resources, and the high 3D design requirements of users. To overcome these issues, a cloud service platform for the seamless integration of digital design and rapid prototyping manufacturing was established using {ASP}.{NET}, {WebGL}, {WebSocket}, and {SQL} Server in combination with C\# language and {JavaScript}. The goals were to realize a design and rapid prototyping of mechanical equipment parts that are browser based and provide online digital design services, such as the parametric design of key parts, downloading of models, format conversion, and virtual assembly. The client application layer, server processing layer, database layer, and working machine end application layer of this cloud 3D printing platform were set up. The result of the design module could be printed remotely in 3D. Practical application showed that the platform could effectively improve the R\&D and design speed of the parts and components of the mechanical equipment and reduce the effort of designers. In particular, this platform would be suitable for users without a 3D design background. The design and rapid prototyping parts of the platform satisfied the dimensional precision required by enterprises, which provides an important basis for the further verification of the design correctness for small- and medium-sized enterprises and has high application value.},
	pages = {1475--1490},
	number = {5},
	journaltitle = {International Journal of Advanced Manufacturing Technology},
	shortjournal = {Int. J. Adv. Manuf. Technol.},
	author = {Xie, Jiacheng and Yang, Zhaojian and Wang, Xuewen and Lai, Xiaonan},
	urldate = {2025-11-07},
	date = {2019-02-01},
	langid = {english},
	keywords = {Digital design, Rapid prototyping, Remote two-way collaboration, Service platform, {WebGL}, {WebSocket}},
	file = {Full Text PDF:/home/sio2/Zotero/storage/9H39T6Z2/Xie et al. - 2019 - A cloud service platform for the seamless integration of digital design and rapid prototyping manufa.pdf:application/pdf},
}

