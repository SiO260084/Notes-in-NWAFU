@article{QuMengMiHeYiHuoKuoZhangGongTongFuYuShiJiaoXiaNongYeJiJieHuaYuShouRuBuPingDeng2025,
  title = {“弥合”抑或“扩张”：共同富裕视角下农业机械化与收入不平等},
  author = {{曲朦} and {韩佳莹} and {管睿}},
