@article{LiuWeiChanLiangDaXianJiangLiZhengCeNengTiGaoNongHuZhongLiangJiJiXingMaJianLunNongYeJiJieHeGuanGaiMianJiDeYingXiangJiZhi2026,
  title = {产粮大县奖励政策能提高农户种粮积极性吗?——兼论农业机械和灌溉面积的影响机制},
  shorttitle = {产粮大县奖励政策能提高农户种粮积极性吗?},
  author = {{刘威} and {张亚楠}},
  date = {2026},
  journaltitle = {中国农机化学报},
  shortjournal = {中国农机化学报},
  volume = {47},
  number = {1},
  pages = {331--338},
  issn = {2095-5553},
  doi = {10.13733/j.jcam.issn.2095-5553.2026.01.045},
  url = {https://link.cnki.net/doi/10.13733/j.jcam.issn.2095-5553.2026.01.045},
  urldate = {2025-12-30},
  abstract = {农民粮食种植积极性直接关系到国家粮食安全，提高农户种粮积极性是保障国家安全的重要举措。基于中国粮食主产区与非主产区30个省(市)的面板数据，采用双重差分法实证分析产粮大县奖励政策对农户种粮积极性的影响效应。研究表明，产粮大县奖励政策显著提高农户的种粮意愿、种粮效率和种粮收益；从时间效应看，从产粮大县奖励政策实施的第4年开始，影响效应得以显现，且长期效应逐渐增强；从异质性结果看，产粮大县奖励政策对北方农户种粮积极性的促进作用更强；从影响机制结果看，产粮大县奖励政策能够通过提高农业机械总动力和灌溉面积，激发农户的种粮积极性。据此，提出细化政策补贴标准，加强政策监督与评估；针对不同粮食主产区，采取差异化政策支持；明确政策支持的重点方向，提高支农惠农实效等建议。},
  langid = {chinese},
  keywords = {产粮大县,双重差分,种粮积极性,粮食安全,粮食生产},
  annotation = {original-container-title: Journal of Chinese Agricultural Mechanization\\
AIF: 1.636\\
CIF: 2.916\\
CLC: F326.11\\
dbcode: CJFQ\\
dbname: CJFDAUTODAY\\
filename: GLJH202601045\\
